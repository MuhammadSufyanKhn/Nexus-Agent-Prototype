# ================================================================
# Nexus Agent – Automation Service  |  Environment Variables
# ================================================================
# Copy this file to .env and fill in the values for local dev.
# NEVER commit a filled-in .env to source control.
# In production, set these as container environment variables.

# ── REQUIRED ──────────────────────────────────────────────────
# Must match Automation:ApiKey in the ASP.NET Core appsettings.json.
API_KEY=your-super-secret-shared-key-change-me

# ── SMTP ──────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@nexusagent.io
SMTP_USE_TLS=true

# ── Alert Recipients ──────────────────────────────────────────
FINANCE_ALERT_EMAIL=finance@nexusagent.io
HR_ALERT_EMAIL=hr@nexusagent.io

# ── Slack (optional) ──────────────────────────────────────────
# Leave blank to disable Slack notifications.
SLACK_WEBHOOK_URL=

# ── Microsoft Teams (optional) ────────────────────────────────
# Leave blank to disable Teams notifications.
TEAMS_WEBHOOK_URL=

# ── Redis (optional) ──────────────────────────────────────────
# If not set, idempotency falls back to in-memory (cleared on restart).
REDIS_URL=redis://localhost:6379/0
IDEMPOTENCY_TTL_SECONDS=86400

# ── Service ───────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
